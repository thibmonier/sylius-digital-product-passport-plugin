{
    "name": "tmonier/sylius-digital-product-passport-plugin",
    "type": "sylius-plugin",
    "description": "Digital Product Passport plugin for Sylius 2: open and versioned sustainability data model (origin, recyclability, repairability), public passport page, no regulatory compliance promise",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "ecommerce",
        "symfony",
        "digital-product-passport",
        "dpp",
        "sustainability",
        "ecodesign",
        "espr",
        "repairability",
        "recyclability"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "sylius/sylius": "^2.2.9 || ^2.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^2.0",
        "sylius-labs/coding-standard": "^4.4",
        "sylius/test-application": "^2.0.0@alpha",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0",
        "symfony/css-selector": "^6.4 || ^7.4 || ^8.0",
        "symfony/debug-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/dom-crawler": "^6.4 || ^7.4 || ^8.0",
        "symfony/dotenv": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/intl": "^6.4 || ^7.4 || ^8.0",
        "symfony/runtime": "^6.4 || ^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "symfony/flex": true,
            "symfony/runtime": true,
            "symfony/thanks": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        },
        "symfony": {
            "require": "^6.4 || ^7.4 || ^8.0"
        }
    },
    "autoload": {
        "psr-4": {
            "Tmonier\\SyliusDigitalProductPassportPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Tmonier\\SyliusDigitalProductPassportPlugin\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
